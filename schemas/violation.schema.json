{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deepfugue/schemas/violation.schema.json",
  "title": "Violation",
  "description": "One detected rule violation (Spec Section 15.4).",
  "type": "object",
  "required": ["rule_id", "severity", "piece_id", "voice_ids", "note_ids", "onset_q", "message"],
  "properties": {
    "rule_id": {"type": "string"},
    "severity": {"type": "string", "enum": ["diagnostic", "soft", "hard"]},
    "piece_id": {"type": "string"},
    "voice_ids": {"type": "array", "items": {"type": "string"}},
    "note_ids": {"type": "array", "items": {"type": "string"}},
    "onset_q": {"type": "string", "pattern": "^-?\\d+(/\\d+)?$"},
    "measure_number": {"type": ["string", "null"]},
    "evidence": {"type": "object"},
    "message": {"type": "string"}
  }
}
